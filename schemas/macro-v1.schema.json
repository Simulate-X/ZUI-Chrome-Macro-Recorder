{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zui.local/schemas/macro-v1.schema.json",
  "title": "ZUI Macro Recorder macro v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "playbackDefaults", "events"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "format": "uri" },
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator"],
          "properties": {
            "kind": { "enum": ["canvas", "container", "viewport"] },
            "locator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["strategy", "value"],
              "properties": {
                "strategy": { "const": "css" },
                "value": { "type": "string", "minLength": 1 }
              }
            },
            "recordedGeometry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["widthCssPx", "heightCssPx"],
              "properties": {
                "widthCssPx": { "type": "number", "exclusiveMinimum": 0 },
                "heightCssPx": { "type": "number", "exclusiveMinimum": 0 },
                "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        }
      }
    },
    "recordingProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyboard", "mouse", "mouseMode"],
      "properties": {
        "keyboard": { "type": "boolean" },
        "mouse": { "type": "boolean" },
        "mouseMode": { "enum": ["clicks-only", "clicks-and-movement"] },
        "wheel": { "type": "boolean" }
      }
    },
    "playbackDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speedMultiplier", "repeatCount", "loopDelayMs", "stopOnError"],
      "properties": {
        "speedMultiplier": { "type": "number", "exclusiveMinimum": 0 },
        "repeatCount": { "type": "integer", "minimum": 0 },
        "loopDelayMs": { "type": "number", "minimum": 0 },
        "stopOnError": { "type": "boolean" }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "baseEvent": {
      "type": "object",
      "required": ["id", "type", "enabled"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "enabled": { "type": "boolean" },
        "label": { "type": "string" }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "x", "y"],
      "properties": {
        "space": { "const": "target-normalized" },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "event": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/baseEvent" },
            {
              "additionalProperties": false,
              "required": ["durationMs"],
              "properties": {
                "id": true, "enabled": true, "label": true,
                "type": { "const": "delay" },
                "durationMs": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseEvent" },
            {
              "additionalProperties": false,
              "required": ["position"],
              "properties": {
                "id": true, "enabled": true, "label": true,
                "type": { "enum": ["mouseDown", "mouseUp", "mouseMove", "mouseWheel"] },
                "position": { "$ref": "#/$defs/position" },
                "button": { "enum": ["left", "middle", "right", "back", "forward", "none"] },
                "buttons": { "type": "integer", "minimum": 0 },
                "deltaX": { "type": "number" },
                "deltaY": { "type": "number" },
                "deltaMode": { "type": "integer", "minimum": 0, "maximum": 2 },
                "modifiers": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "enum": ["Alt", "Control", "Meta", "Shift"] }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "type": { "const": "mouseWheel" } } },
                  "then": { "required": ["deltaX", "deltaY", "deltaMode"] }
                }
              ]
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseEvent" },
            {
              "additionalProperties": false,
              "properties": {
                "id": true, "enabled": true, "label": true,
                "type": { "enum": ["keyDown", "keyUp"] },
                "key": { "type": "string", "minLength": 1 },
                "code": { "type": "string", "minLength": 1 },
                "location": { "type": "integer", "minimum": 0 },
                "repeat": { "type": "boolean" },
                "modifiers": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "enum": ["Alt", "Control", "Meta", "Shift"] }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseEvent" },
            {
              "additionalProperties": false,
              "required": ["value"],
              "properties": {
                "id": true, "enabled": true, "label": true,
                "type": { "enum": ["text", "ime"] },
                "value": { "type": "string" }
              }
            }
          ]
        }
      ]
    }
  }
}
